rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada jogador só pode ler/escrever o próprio documento de progresso.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Ranking: leitura pública (qualquer um vê o leaderboard), mas só o
    // próprio jogador pode escrever sua própria entrada.
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
